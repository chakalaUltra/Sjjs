# Viber bot token (obtain from Viber Public Account dashboard)
VIBER_AUTH_TOKEN=YOUR_VIBER_AUTH_TOKEN

# Groq AI API key (obtain from https://groq.com)
GROQ_API_KEY=YOUR_GROQ_API_KEY

# Optional: model to use (default: llama3-70b-8192)
GROQ_MODEL=llama3-70b-8192

# Port for the webhook server (default: 3000)
PORT=3000